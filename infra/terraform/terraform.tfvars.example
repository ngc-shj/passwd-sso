project_name = "passwd-sso"
env          = "dev"
aws_region   = "ap-northeast-1"

azs = ["ap-northeast-1a", "ap-northeast-1c"]

vpc_cidr             = "10.10.0.0/16"
public_subnet_cidrs  = ["10.10.0.0/24", "10.10.1.0/24"]
private_subnet_cidrs = ["10.10.10.0/24", "10.10.11.0/24"]

app_domain     = "app.example.com"
jackson_domain = "sso.example.com"
hosted_zone_id = "ZXXXXXXXXXXXXX"

create_acm_certificate = true
# acm_certificate_arn = "arn:aws:acm:..."

# Container images — after first `terraform apply`, use ECR output URLs:
#   terraform output -raw ecr_app_repository_url
#   terraform output -raw ecr_jackson_repository_url
# ECR is IMMUTABLE: pin an explicit version tag (:vX.Y.Z) or @sha256 digest.
# :latest is rejected by the app_image / jackson_image variable validation.
app_image     = "<ACCOUNT_ID>.dkr.ecr.ap-northeast-1.amazonaws.com/passwd-sso-dev-app:v0.4.71"
jackson_image = "<ACCOUNT_ID>.dkr.ecr.ap-northeast-1.amazonaws.com/passwd-sso-dev-jackson:v1.42.0"

# SECRETS ARE NOT SET HERE (2026-07 review, F3). app_secrets / jackson_secrets
# variables were removed — passing secret values through Terraform writes them
# into state as plaintext. Terraform creates only the empty secret CONTAINERS
# (secrets.tf); inject the VALUES out-of-band AFTER apply, BEFORE ECS starts:
#
#   # app-secrets.json (mode 0600, DELETE after injecting; do NOT commit):
#   # {
#   #   "DATABASE_URL": "postgresql://passwd_app:PASSWORD@HOST:5432/passwd_sso",
#   #   "MIGRATION_DATABASE_URL": "postgresql://passwd_user:PASSWORD@HOST:5432/passwd_sso",
#   #   "AUTH_URL": "https://app.example.com",
#   #   "AUTH_SECRET": "<REPLACE>",
#   #   "AUTH_GOOGLE_ID": "<REPLACE>", "AUTH_GOOGLE_SECRET": "<REPLACE>",
#   #   "AUTH_JACKSON_ID": "<REPLACE>", "AUTH_JACKSON_SECRET": "<REPLACE>",
#   #   "SHARE_MASTER_KEY": "<REPLACE>",   // npm run generate:key
#   #   "REDIS_URL": "redis://HOST:6379"
#   # }
#   # jackson-secrets.json:
#   # { "JACKSON_API_KEYS": "<REPLACE>", "DB_URL": "...",
#   #   "NEXTAUTH_URL": "https://sso.example.com",
#   #   "EXTERNAL_URL": "https://sso.example.com", "NEXTAUTH_SECRET": "<REPLACE>" }
#
#   scripts/put-terraform-secrets.sh \
#     --name-prefix passwd-sso-dev \
#     --app-file ./app-secrets.json --jackson-file ./jackson-secrets.json

db_username = "passwd_user"  # SUPERUSER — table owner, used for migrations
db_password = "<REPLACE>"   # Use a strong, random password

# RDS safety (prod推奨)
db_apply_immediately    = false
db_skip_final_snapshot  = false
db_multi_az             = true
db_backup_retention_days = 7
db_deletion_protection  = true

# Redis (prod推奨)
redis_use_replication_group      = true
redis_transit_encryption_enabled = true
redis_at_rest_encryption_enabled = true
redis_auth_token                 = "<REPLACE>"
redis_num_node_groups            = 1
redis_replicas_per_node_group    = 1

# Attachments (S3 + optional CloudFront)
enable_s3_attachments      = true
attachments_bucket_name    = ""
enable_cloudfront          = false
cloudfront_aliases         = []
cloudfront_certificate_arn = ""
