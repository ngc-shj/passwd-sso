project_name = "passwd-sso"
env          = "prod"
aws_region   = "ap-northeast-1"

azs = ["ap-northeast-1a", "ap-northeast-1c"]

vpc_cidr             = "10.20.0.0/16"
public_subnet_cidrs  = ["10.20.0.0/24", "10.20.1.0/24"]
private_subnet_cidrs = ["10.20.10.0/24", "10.20.11.0/24"]

# nat_gateway_count = 2  # Recommended: 1 per AZ for HA

app_domain     = "app.example.com"
jackson_domain = "sso.example.com"
hosted_zone_id = "ZXXXXXXXXXXXXX"

create_acm_certificate = true

# Container images — use ECR repository URLs from terraform output.
# ECR is IMMUTABLE: pin an explicit version tag (:vX.Y.Z) or @sha256 digest,
# never :latest (rejected by variable validation).
app_image     = "<ACCOUNT_ID>.dkr.ecr.ap-northeast-1.amazonaws.com/passwd-sso-prod-app:v0.4.71"
jackson_image = "<ACCOUNT_ID>.dkr.ecr.ap-northeast-1.amazonaws.com/passwd-sso-prod-jackson:v1.42.0"

# app_desired_count    = 2  # Recommended for prod HA
# jackson_desired_count = 2

# SECRETS ARE NOT SET HERE (2026-07 review, F3). Inject secret VALUES out-of-band
# after apply — they must never enter Terraform state. See the root
# infra/terraform/terraform.tfvars.example for the JSON shape, then run:
#   scripts/put-terraform-secrets.sh --name-prefix passwd-sso-prod \
#     --app-file ./app-secrets.json --jackson-file ./jackson-secrets.json

db_username = "passwd_user"  # SUPERUSER — table owner, used for migrations
db_password = "<REPLACE>"   # Use a strong, random password

# RDS — production safety
db_apply_immediately    = false
db_skip_final_snapshot  = false
db_multi_az             = true
db_backup_retention_days = 7
db_deletion_protection  = true

# Redis — replication group with encryption (prod)
redis_use_replication_group      = true
redis_transit_encryption_enabled = true
redis_at_rest_encryption_enabled = true
redis_auth_token                 = "<REPLACE>"
redis_num_node_groups            = 1
redis_replicas_per_node_group    = 1

# Attachments (S3 + optional CloudFront)
enable_s3_attachments      = true
attachments_bucket_name    = ""
enable_cloudfront          = false
cloudfront_aliases         = []
cloudfront_certificate_arn = ""

# Backup — production (ransomware-resistant)
enable_backup                  = true
backup_vault_lock              = true
backup_vault_lock_cooloff_days = 3
backup_retention_days          = 35
backup_min_retention_days      = 7
backup_max_retention_days      = 120
backup_cross_region            = "ap-southeast-1" # DR: Singapore

# Backup failure alerts
backup_alert_email = "ops@example.com"

# S3 Object Lock (new deployments only, Compliance mode)
enable_s3_object_lock = true
s3_object_lock_days   = 90
