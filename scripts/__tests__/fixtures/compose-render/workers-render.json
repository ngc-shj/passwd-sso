          "PASSWD_ANCHOR_PUBLISHER_PASSWORD": "",
          "PASSWD_APP_PASSWORD": "",
          "PASSWD_AUDIT_CHAIN_VERIFIER_PASSWORD": "",
          "PASSWD_JACKSON_PASSWORD": "",
          "PASSWD_OUTBOX_WORKER_PASSWORD": "",
          "PASSWD_RETENTION_GC_WORKER_PASSWORD": "",
          "PASSWD_SUPERUSER_PASSWORD": "",
