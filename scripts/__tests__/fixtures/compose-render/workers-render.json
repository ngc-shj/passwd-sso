        "restart": "unless-stopped",
        "volumes": [
          {
            "type": "volume",
            "source": "postgres_data",
            "target": "/var/lib/postgresql/data",
            "volume": {}
          },
          {
            "type": "bind",
            "source": "<stub>/infra/postgres/initdb",
            "target": "/docker-entrypoint-initdb.d",
            "read_only": true,
            "bind": {}
          }
        ]
      },
      "jackson": {
        "command": null,
        "depends_on": {
          "db": {
            "condition": "service_healthy",
            "required": true
          }
        },
        "entrypoint": null,
        "environment": {
          "DB_ENGINE": "sql",
          "DB_TYPE": "postgres",
          "DB_URL": "postgresql://jackson_user:{{PASSWD_JACKSON_PASSWORD}}@db:5432/jackson",
          "EXTERNAL_URL": "http://localhost:5225",
          "JACKSON_API_KEYS": "{{JACKSON_API_KEY}}",
          "NEXTAUTH_ACL": "*",
          "NEXTAUTH_SECRET": "{{AUTH_SECRET}}",
          "NEXTAUTH_URL": "http://localhost:5225"
        },
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "node -e \"const http=require('http');const os=require('os');http.get('http://'+os.hostname()+':5225/api/health',r=>{process.exit(r.statusCode===200?0:1)}).on('error',()=>process.exit(1))\""
          ],
          "timeout": "10s",
          "interval": "15s",
          "retries": 10,
          "start_period": "1m0s"
        },
        "image": "boxyhq/jackson:1.52.2",
        "logging": {
          "driver": "json-file",
          "options": {
            "max-file": "5",
            "max-size": "20m"
          }
        },
        "networks": {
          "internal": null
        },
        "restart": "unless-stopped"
      },
      "migrate": {
        "profiles": [
          "migrate"
