          "PASSWD_ANCHOR_PUBLISHER_PASSWORD": "{{PASSWD_ANCHOR_PUBLISHER_PASSWORD}}",
          "PASSWD_APP_PASSWORD": "{{PASSWD_APP_PASSWORD}}",
          "PASSWD_AUDIT_CHAIN_VERIFIER_PASSWORD": "{{PASSWD_AUDIT_CHAIN_VERIFIER_PASSWORD}}",
