        "logging": {
          "driver": "json-file",
          "options": {
            "max-file": "5",
            "max-size": "20m"
          }
        },
        "networks": {
          "internal": null
        },
        "ports": [
          {
            "mode": "ingress",
            "target": 3000,
            "published": "3000",
            "protocol": "tcp"
          }
        ],
        "restart": "unless-stopped"
      },
