          "AUDIT_ANCHOR_TAG_SECRET": "{{AUDIT_ANCHOR_TAG_SECRET}}",
          "AWS_ACCESS_KEY_ID": "{{AUDIT_ANCHOR_AWS_ACCESS_KEY_ID}}",
          "AWS_REGION": "us-east-1",
          "AWS_SECRET_ACCESS_KEY": "{{AUDIT_ANCHOR_AWS_SECRET_ACCESS_KEY}}",
          "DATABASE_URL": "",
          "DEPLOYMENT_ID": "{{DEPLOYMENT_ID}}"
