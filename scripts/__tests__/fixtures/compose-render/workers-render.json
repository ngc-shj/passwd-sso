          "driver": "json-file",
          "options": {
            "max-file": "5",
            "max-size": "20m"
          }
        },
        "networks": {
          "internal": null
        },
        "restart": "no"
      },
      "redis": {
        "command": [
          "redis-server",
          "--appendonly",
          "yes",
          "--requirepass",
          "{{REDIS_PASSWORD}}"
        ],
        "entrypoint": null,
        "environment": {
          "REDISCLI_AUTH": "{{REDIS_PASSWORD}}"
        },
        "healthcheck": {
          "test": [
            "CMD-SHELL",
            "redis-cli ping | grep PONG"
          ],
          "timeout": "3s",
          "interval": "5s",
          "retries": 5
