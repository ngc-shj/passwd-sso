          "PASSWD_OUTBOX_WORKER_PASSWORD": "{{PASSWD_OUTBOX_WORKER_PASSWORD}}",
          "PASSWD_RETENTION_GC_WORKER_PASSWORD": "{{PASSWD_RETENTION_GC_WORKER_PASSWORD}}",
          "POSTGRES_DB": "passwd_sso",
          "POSTGRES_PASSWORD": "{{PASSWD_SUPERUSER_PASSWORD}}",
          "POSTGRES_USER": "passwd_user"
        },
