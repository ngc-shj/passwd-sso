  "render": {
    "name": "compose-render",
    "networks": {
      "internal": {
        "name": "compose-render_internal",
        "driver": "bridge",
        "ipam": {}
      }
    },
    "services": {
      "app": {
        "build": {
          "context": "<stub>",
          "dockerfile": "Dockerfile",
          "args": {
            "DATABASE_URL": "postgresql://build:build@localhost:5432/passwd_sso"
          }
        },
        "command": null,
        "depends_on": {
          "db": {
            "condition": "service_healthy",
            "required": true
          },
          "jackson": {
            "condition": "service_healthy",
            "required": true
          },
          "redis": {
            "condition": "service_healthy",
            "required": true
          }
        },
        "entrypoint": null,
        "environment": {
          "AUDIT_ANCHOR_AWS_ACCESS_KEY_ID": "",
          "AUDIT_ANCHOR_AWS_REGION": "",
          "AUDIT_ANCHOR_AWS_SECRET_ACCESS_KEY": "",
          "AUDIT_ANCHOR_DESTINATION_GH_TOKEN": "",
          "AUDIT_ANCHOR_DESTINATION_S3_BUCKET": "stub-audit-anchors",
          "AUDIT_ANCHOR_DESTINATION_S3_PREFIX": "stub-prefix",
          "AUDIT_ANCHOR_PUBLISHER_DATABASE_URL": "",
          "AUDIT_ANCHOR_SIGNING_KEY": "",
          "AUDIT_ANCHOR_TAG_SECRET": "",
          "AUDIT_CHAIN_VERIFY_DATABASE_URL": "",
          "AUTH_SECRET": "{{AUTH_SECRET}}",
          "COMPOSE_RENDER_CANARY": "{{COMPOSE_RENDER_CANARY}}",
          "DATABASE_URL": "postgresql://passwd_app:{{PASSWD_APP_PASSWORD}}@db:5432/passwd_sso",
          "DEPLOYMENT_ID": "{{DEPLOYMENT_ID}}",
          "GITHUB_TOKEN": "",
          "JACKSON_API_KEY": "",
          "JACKSON_URL": "http://jackson:5225",
          "MIGRATION_DATABASE_URL": "",
          "OUTBOX_WORKER_DATABASE_URL": "",
          "PASSWD_ANCHOR_PUBLISHER_PASSWORD": "",
          "PASSWD_APP_PASSWORD": "",
          "PASSWD_AUDIT_CHAIN_VERIFIER_PASSWORD": "",
          "PASSWD_JACKSON_PASSWORD": "",
          "PASSWD_OUTBOX_WORKER_PASSWORD": "",
          "PASSWD_RETENTION_GC_WORKER_PASSWORD": "",
          "PASSWD_SUPERUSER_PASSWORD": "",
          "REDIS_PASSWORD": "{{REDIS_PASSWORD}}",
          "REDIS_URL": "redis://:{{REDIS_PASSWORD}}@redis:6379",
          "RETENTION_GC_DATABASE_URL": "",
          "SENTRY_AUTH_TOKEN": ""
