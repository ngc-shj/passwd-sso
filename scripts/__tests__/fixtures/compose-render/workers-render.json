        "build": {
          "context": "<stub>",
          "dockerfile": "Dockerfile",
          "args": {
            "DATABASE_URL": "postgresql://build:build@localhost:5432/passwd_sso"
          }
        },
        "command": [
          "npx",
          "prisma",
          "migrate",
          "deploy"
